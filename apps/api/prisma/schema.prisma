// HullOps data model. Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The API is compiled to CommonJS (see tsconfig.json), so generate a CJS client
  // explicitly instead of relying on Prisma's format detection.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PROJECT_LEAD
  WORKER
}

// Language for text the server sends a user (e.g. emails). The web app
// translates everything else itself.
enum Locale {
  EN
  DE
}

// The two service areas
enum ServiceType {
  CLEANING
  PROTECTION
}

enum OrderStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(WORKER)
  serviceTypes ServiceType[] // service areas this person can work in
  locale       Locale        @default(EN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdOrders Order[]           @relation("OrderCreatedBy")
  assignments   OrderAssignment[]
  statusUpdates StatusUpdate[]
  orderComments OrderComment[]
}

model Vessel {
  id         String   @id @default(cuid())
  name       String
  imoNumber  String?  @unique // International Maritime Organization ship number
  vesselType String? // e.g. yacht, container ship
  lengthM    Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]
}

model Order {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      OrderStatus @default(PLANNED)
  serviceType ServiceType // cleaning or protection
  shipyard    String // e.g. Blohm+Voss
  berth       String? // berth / dock
  areaSqm     Float? // area to clean, in m²
  startDate   DateTime
  dueDate     DateTime // "overdue" = dueDate < now && status != DONE (computed, never stored)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  vesselId    String
  vessel      Vessel @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignments   OrderAssignment[]
  statusUpdates StatusUpdate[]
  comments      OrderComment[]

  // Service-specific details (1:1). Exactly one is set, matching serviceType;
  // the database doesn't enforce this, so application code must.
  cleaningDetails   CleaningDetails?
  protectionDetails ProtectionDetails?

  @@index([status])
  @@index([serviceType])
  @@index([dueDate])
  @@index([vesselId])
}

// Details for cleaning orders
model CleaningDetails {
  orderId String @id
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  String // e.g. high-pressure, blasting, manual
  surface String // e.g. hull, deck, interior
}

// Kind of protection. Protection can run at the same time as cleaning.
enum ProtectionKind {
  ENCLOSURE // e.g. wooden boxes around machines
  COVERING // e.g. foil, tarpaulins
  FLOOR // floor protection: protects the deck or floor
  COATING // coating
}

// Protection materials
enum ProtectionMaterial {
  OSB_STANDARD
  OSB_FIRE_RESISTANT // fire-resistant
  PROPLEX_3MM
  PROPLEX_HD
  GLASS_FIBER_FABRIC // protects against fire and welding sparks
}

// Details for protection orders
model ProtectionDetails {
  orderId           String               @id
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind              ProtectionKind
  protectedItem     String? // what is protected, e.g. main engine, generator
  materials         ProtectionMaterial[] // e.g. OSB box + Proplex on the floor
  // only relevant for coatings:
  coatingProduct    String?
  layers            Int?
  targetThicknessUm Int? // target coating thickness in µm
}

// The team on an order (many-to-many User <-> Order)
model OrderAssignment {
  orderId    String
  userId     String
  assignedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orderId, userId])
}

// History: every status change or note from the team, with optional photos
model StatusUpdate {
  id        String      @id @default(cuid())
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId String
  author   User    @relation(fields: [authorId], references: [id])
  photos   Photo[]

  @@index([orderId, createdAt])
}

// Free-text information on an order that the app has no field for. The
// project lead passes on what the shipyard tells them; the team reads it.
model OrderComment {
  id        String   @id @default(cuid())
  text      String
  source    String? // where it came from, e.g. "Lürssen, J. Meyer, by mail"
  createdAt DateTime @default(now())

  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([orderId, createdAt])
}

model Photo {
  id         String   @id @default(cuid())
  storageKey String // object key in storage (e.g. S3)
  mimeType   String
  createdAt  DateTime @default(now())

  statusUpdateId String
  statusUpdate   StatusUpdate @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)
}
