# Copy to .env. These values match the Postgres container in the root docker-compose.yml.
DATABASE_URL="postgresql://hullops:hullops@localhost:5432/hullops"

# Signs login tokens. Replace with your own random value of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-me-with-a-long-random-value-0123456789"

# Optional, with their defaults:
# PORT=4000
# NODE_ENV=development
# CORS_ORIGINS=http://localhost:3000
# JWT_EXPIRES_IN_HOURS=8
