// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The API is compiled to CommonJS (see tsconfig.json), so generate a CJS client
  // explicitly instead of relying on Prisma's format detection.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// HullOps – Datenmodell (Woche 1)
// WICHTIG: Den "generator"- und "datasource"-Block aus `prisma init`
// behalten und nur die Enums + Models unten einfügen.

enum Role {
  PROJECT_LEAD
  WORKER
}

// Die zwei Fachbereiche
enum ServiceType {
  CLEANING
  PROTECTION
}

enum OrderStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  name          String
  role          Role              @default(WORKER)
  serviceTypes  ServiceType[]     // Fachbereiche, in denen die Person arbeiten kann
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdOrders Order[]           @relation("OrderCreatedBy")
  assignments   OrderAssignment[]
  statusUpdates StatusUpdate[]
}

model Vessel {
  id         String   @id @default(cuid())
  name       String
  imoNumber  String?  @unique // internationale Schiffsnummer
  vesselType String?          // z. B. Yacht, Containerschiff
  lengthM    Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]
}

model Order {
  id          String            @id @default(cuid())
  title       String
  description String?
  status      OrderStatus       @default(PLANNED)
  serviceType ServiceType       // Reinigung oder Schutz
  shipyard    String            // z. B. Blohm+Voss
  berth       String?           // Liegeplatz / Dock
  areaSqm     Float?            // zu reinigende Fläche
  startDate   DateTime
  dueDate     DateTime          // "verspätet" = dueDate < jetzt && status != DONE (berechnet, nicht gespeichert)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  vesselId    String
  vessel      Vessel            @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User              @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignments   OrderAssignment[]
  statusUpdates StatusUpdate[]

  // Fachspezifische Details (1:1, nur eins davon ist gesetzt – passend zu serviceType)
  cleaningDetails   CleaningDetails?
  protectionDetails ProtectionDetails?

  @@index([status])
  @@index([serviceType])
  @@index([dueDate])
  @@index([vesselId])
}

// Details für Reinigungsaufträge
model CleaningDetails {
  orderId String  @id
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  String  // z. B. Hochdruck, Strahlen, manuell
  surface String  // z. B. Rumpf, Deck, Innenraum
}

// Art des Schutzes – kann auch parallel zur Reinigung laufen
enum ProtectionKind {
  ENCLOSURE // Einhausung, z. B. Holzkisten um Maschinen
  COVERING  // Abdeckung, z. B. Folie, Planen
  FLOOR     // Flurschutz – Schutz vom Deck/Boden
  COATING   // Beschichtung
}

// Verwendete Schutzmaterialien
enum ProtectionMaterial {
  OSB_STANDARD
  OSB_FIRE_RESISTANT // feuerfest
  PROPLEX_3MM
  PROPLEX_HD
  GLASS_FIBER_FABRIC // "Mahlglas", Glasfasergewebe – Schutz gegen Feuer und Schweißfunken
}

// Details für Schutzaufträge
model ProtectionDetails {
  orderId           String         @id
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind              ProtectionKind
  protectedItem     String?        // was geschützt wird, z. B. Hauptmaschine, Generator
  materials         ProtectionMaterial[] // z. B. OSB-Kiste + Proplex am Boden
  // nur bei Beschichtung relevant:
  coatingProduct    String?
  layers            Int?
  targetThicknessUm Int?           // Soll-Schichtdicke in µm
}

// Team pro Auftrag (Many-to-Many User <-> Order)
model OrderAssignment {
  orderId    String
  userId     String
  assignedAt DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orderId, userId])
}

// Verlauf: jede Statusänderung / Notiz vom Team (Fotos kommen in Woche 6)
model StatusUpdate {
  id        String       @id @default(cuid())
  status    OrderStatus
  note      String?
  createdAt DateTime     @default(now())

  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  photos    Photo[]

  @@index([orderId, createdAt])
}

model Photo {
  id             String       @id @default(cuid())
  storageKey     String       // Pfad im Storage (S3 o. ä.)
  mimeType       String
  createdAt      DateTime     @default(now())

  statusUpdateId String
  statusUpdate   StatusUpdate @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)
}
